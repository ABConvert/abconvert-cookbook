# Copy to .env and fill in. Never commit the filled-in file.
# Load it however your runner prefers, for example: set -a; source .env; set +a
#
# Every variable an example reads is listed here. The commented ones are
# optional and show the default the script uses.

# Every example
ABCONVERT_API_TOKEN=abcv_live_replace_me
ABCONVERT_API_BASE=https://api.abconvert.io/v1

# examples/slack-report
ANTHROPIC_API_KEY=sk-ant-replace-me
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
# REPORT_DAY_MARKS=7,14
# ANTHROPIC_MODEL=claude-sonnet-5
# DRY_RUN=1                        # print the message instead of posting it
# SKIP_LLM=1                       # post the raw figures with no summary

# examples/guardrail-monitor (needs a write token)
# GUARDRAIL_METRIC=conversion_rate
# GUARDRAIL_MAX_DROP=0.10
# GUARDRAIL_MIN_SAMPLE=1000
# GUARDRAIL_MAX_P_VALUE=0.05
# GUARDRAIL_ONLY_IDS=3021,3022     # watch a subset
# DRY_RUN=1                        # report breaches without pausing

# examples/portfolio-dashboard (one entry per store)
ABCONVERT_API_TOKENS=northwind=abcv_live_replace_me,acme=abcv_live_replace_me_too
# DASHBOARD_OUT_DIR=./out
# DASHBOARD_STATUSES=active,paused
# DASHBOARD_DETAIL=decided         # decided | all | none
# REQUEST_SPACING_MS=1100

# examples/order-export (needs a write token)
EXPORT_EXPERIMENT_ID=3021
# EXPORT_GTE=2026-08-01            # calendar day, default 29 days ago
# EXPORT_LTE=2026-08-30            # calendar day, default today
# EXPORT_SAMPLE_BASIS=assignment   # assignment | exposure
# EXPORT_IDEMPOTENCY_KEY=          # supply your own when a queue owns the retry
# EXPORT_OUT_DIR=./out
# EXPORT_POLL_MS=5000
# EXPORT_TIMEOUT_MS=600000
